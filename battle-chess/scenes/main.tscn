[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/view/board_view.gd" id="1_board"]
[ext_resource type="PackedScene" path="res://scenes/piece.tscn" id="2_piece"]
[ext_resource type="Script" path="res://scripts/view/camera_rig.gd" id="3_camera"]
[ext_resource type="Script" path="res://scripts/game_manager.gd" id="4_game"]
[ext_resource type="Script" path="res://scripts/view/hud.gd" id="5_hud"]

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_1"]

[sub_resource type="Sky" id="Sky_1"]
sky_material = SubResource("ProceduralSkyMaterial_1")

[sub_resource type="Environment" id="Environment_1"]
background_mode = 2
sky = SubResource("Sky_1")
ambient_light_source = 3
tonemap_mode = 2

[node name="Main" type="Node3D"]

[node name="BoardView" type="Node3D" parent="."]
script = ExtResource("1_board")
piece_scene = ExtResource("2_piece")

[node name="Squares" type="Node3D" parent="BoardView"]

[node name="Highlights" type="Node3D" parent="BoardView"]

[node name="Pieces" type="Node3D" parent="BoardView"]

[node name="CameraRig" type="Node3D" parent="."]
script = ExtResource("3_camera")

[node name="Pitch" type="Node3D" parent="CameraRig"]

[node name="Camera3D" type="Camera3D" parent="CameraRig/Pitch"]
fov = 50.0

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.8192, 0, -0.5736, -0.4698, 0.5736, -0.6711, 0.329, 0.8192, 0.4698, 0, 6, 0)
shadow_enabled = true

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_1")

[node name="GameManager" type="Node" parent="." node_paths=PackedStringArray("board_view")]
script = ExtResource("4_game")
board_view = NodePath("../BoardView")

[node name="HUD" type="CanvasLayer" parent="." node_paths=PackedStringArray("game")]
script = ExtResource("5_hud")
game = NodePath("../GameManager")

[node name="Margin" type="MarginContainer" parent="HUD"]
offset_right = 600.0
offset_bottom = 120.0
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16

[node name="VBox" type="VBoxContainer" parent="HUD/Margin"]
layout_mode = 2
mouse_filter = 2

[node name="StatusLabel" type="Label" parent="HUD/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 24

[node name="NewGameButton" type="Button" parent="HUD/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Novo jogo"

[node name="HintLabel" type="Label" parent="HUD/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
text = "Esquerdo: selecionar/mover  ·  Direito + arrastar: girar câmera  ·  Roda: zoom"
